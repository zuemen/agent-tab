# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
# Without these the server runs the SIMULATED rail (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal account email(s) that receive seller payouts.
PAYOUT_RECEIVER=
# PAYOUT_HARBOR_GAZETTE=
# PAYOUT_OPENFIELD_DATA=
# PAYOUT_FIELD_PANEL=

# The model behind the buying agent and the tab assistant. Set ONE of these; without any,
# the demo agent runs a scripted plan and the tab assistant is off.
# 1) Gemini (free tier key from aistudio.google.com) via its OpenAI-compatible endpoint:
GEMINI_API_KEY=
# LLM_MODEL=gemini-flash-latest
# 2) Any OpenAI-compatible chat completions server:
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_LABEL=
# 3) Claude (takes precedence when set):
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5
# Runs per hour across all visitors (agent runs + assistant questions):
# MAX_CLAUDE_RUNS_PER_HOUR=20

PORT=4020
# Public URL PayPal redirects back to (set this when deployed).
# PUBLIC_URL=https://your-app.example
PLATFORM_FEE_BPS=1000
# Reverse proxies in front of the server (Render: 1). 0 = rate-limit by socket address.
TRUST_PROXY_HOPS=0
DATA_DIR=.data
