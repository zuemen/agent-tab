# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
# Without these the server runs the SIMULATED rail (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal account email(s) that receive seller payouts.
PAYOUT_RECEIVER=
# PAYOUT_HARBOR_GAZETTE=
# PAYOUT_OPENFIELD_DATA=
# PAYOUT_FIELD_PANEL=

# Optional: lets Claude decide what to buy. Without it the demo agent runs a scripted plan.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# MAX_CLAUDE_RUNS_PER_HOUR=20

PORT=4020
# Public URL PayPal redirects back to (set this when deployed).
# PUBLIC_URL=https://your-app.example
PLATFORM_FEE_BPS=1000
# Reverse proxies in front of the server (Render: 1). 0 = rate-limit by socket address.
TRUST_PROXY_HOPS=0
DATA_DIR=.data
